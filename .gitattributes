# Fixture PDFs are compared byte-for-byte; goldens/specs must not get CRLF on Windows checkouts.
*.pdf binary
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.csv text eol=lf

# Container scripts run under /bin/sh in Linux: CRLF from a Windows checkout would break them.
docker/* text eol=lf
Dockerfile text eol=lf
